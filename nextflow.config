nextflow.enable.dsl = 2

docker {
    enabled = true
    runOptions = '--platform=linux/amd64'
}

process {
    maxForks = 1         // only one process runs at a time
}

params {
    project_dir = "/shared/team/plasmid_gc_pipeline"
    metadata    = "data/sample.csv"
    contigs_dir = "data/assemblies"
    min_pling   = 5
    min_mlst    = 5
    outdir      = "results"
    threads     = 6
    memory      = '48 GB'
}
