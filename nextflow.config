nextflow.enable.dsl = 2

docker {
    enabled = true
    runOptions = '--platform=linux/amd64'
}

process {
    maxForks = 1
}

params {
    project_dir = "/shared/team/plasmid-gc"
    metadata    = "data/sample.csv"
    contigs_dir = "data/assemblies"
    outdir      = "results"
    threads     = 6
    memory      = '48 GB'
}
